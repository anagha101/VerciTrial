VITE_SUPABASE_URL=https://your-project.supabase.co
# Full "anon" "public" JWT from Supabase → Settings → API (one string, exactly two dots → three segments; usually starts with eyJ).
VITE_SUPABASE_ANON_KEY=your-anon-key

# Social footer links (optional — add your profile URLs)
# VITE_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# VITE_SOCIAL_TIKTOK=https://tiktok.com/@yourhandle
# VITE_SOCIAL_YOUTUBE=https://youtube.com/@yourhandle
# VITE_SOCIAL_SOUNDCLOUD=https://soundcloud.com/yourhandle
# VITE_SOCIAL_LINKTREE=https://linktr.ee/yourhandle

